# Postgres from compose.yaml (`npm run db:up`). To use a Postgres you already
# run instead, point both at it, e.g. postgresql://you@localhost:5432/struna.
DATABASE_URL="postgresql://struna:struna@localhost:5433/struna"
# Wiped and rebuilt by `npm test`; the name must end in _test.
TEST_DATABASE_URL="postgresql://struna:struna@localhost:5433/struna_test"

# serve
PORT=8080
HOST=127.0.0.1

# Require `Authorization: Bearer <token>` on WorkerService/Tick (optional)
STRUNA_TICK_TOKEN=

# worker: sleep between ticks while the queue is empty (ms)
STRUNA_IDLE_MS=1000
