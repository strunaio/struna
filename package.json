{
  "name": "struna",
  "description": "BPMN-driven process server",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "dev": "tsx watch src/cli.ts serve --worker",
    "serve": "tsx src/cli.ts serve --worker",
    "worker": "tsx src/cli.ts worker",
    "start": "node dist/cli.js serve",
    "gen": "npm run gen:proto && npm run gen:prisma",
    "gen:proto": "buf generate",
    "gen:prisma": "prisma generate",
    "lint:proto": "buf lint",
    "db:up": "docker compose up -d --wait",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "test": "vitest run",
    "prepare": "npm run gen"
  },
  "type": "module",
  "license": "MIT",
  "dependencies": {
    "@bufbuild/protobuf": "^2.15.0",
    "@connectrpc/connect": "^2.2.0",
    "@connectrpc/connect-node": "^2.2.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "^7.10.0",
    "bpmn-auto-layout": "^1.3.0",
    "bpmn-elements": "^18.1.0",
    "bpmn-engine": "^26.0.5",
    "bpmn-js": "^18.30.1",
    "bpmn-moddle": "^10.3.1",
    "commander": "^15.0.0",
    "eta": "^4.6.0",
    "htmx-ext-sse": "^2.2.4",
    "htmx.org": "^2.0.11"
  },
  "devDependencies": {
    "@bufbuild/buf": "^1.73.0",
    "@bufbuild/protoc-gen-es": "^2.15.0",
    "@types/bpmn-moddle": "^10.0.0",
    "@types/node": "^26.6.2",
    "prisma": "^7.10.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "allowScripts": {
    "@bufbuild/buf@1.73.0": true,
    "@prisma/engines@7.10.0": true,
    "prisma@7.10.0": true,
    "esbuild@0.28.2": true
  },
  "bin": {
    "struna": "dist/cli.js"
  }
}
