// Prisma 7, Postgres only. The connection URL lives in prisma.config.ts; the
// runtime client connects through the pg driver adapter (src/db/client.ts).
generator client {
  provider     = "prisma-client"
  output       = "../src/gen/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// Naming: models and fields stay PascalCase/camelCase for the TypeScript
// client; tables and columns are mapped to snake_case, so hand-written SQL
// (psql, the worker's claim query, dashboards) needs no quoting.
//
// Ids: entities use UUIDv7 in native `uuid` columns — time-ordered, so new
// rows land at the end of the index. The event log and signal inbox keep
// bigserial ids: the event feed's cursor and signal delivery order need a
// sequence, which millisecond timestamps from several processes cannot give.
//
// JSON: variables, engine state and payloads are `jsonb`. Timestamps are
// `timestamptz`, so they mean the same instant whatever the session timezone.

/// A deployed BPMN definition. `source` holds the raw BPMN 2.0 XML.
model ProcessDefinition {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String
  version   Int      @default(1)
  source    String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  instances ProcessInstance[]

  @@unique([name, version])
  @@map("process_definitions")
}

/// A running or finished execution of a ProcessDefinition.
/// `state` is the serialized bpmn-engine state a worker resumes from.
///
/// Scheduling: `runnableAt` is set when the instance has work for a worker
/// (just started, a queued signal or cancel, a due timer) and null when it is
/// parked or finished. A worker owns the instance while `lockedUntil` is in
/// the future.
///
/// Cancel is a request, like a signal: the API sets `cancelRequestedAt` and
/// the worker holding the lease carries it out, so it never races a run.
model ProcessInstance {
  id           String    @id @default(uuid(7)) @db.Uuid
  definitionId String    @map("definition_id") @db.Uuid
  status       String    @default("pending")
  variables    Json      @default("{}")
  state        Json?
  startedAt    DateTime  @default(now()) @map("started_at") @db.Timestamptz(3)
  completedAt  DateTime? @map("completed_at") @db.Timestamptz(3)
  error        String?
  runnableAt   DateTime? @map("runnable_at") @db.Timestamptz(3)
  lockedBy     String?   @map("locked_by")
  lockedUntil  DateTime? @map("locked_until") @db.Timestamptz(3)
  cancelRequestedAt DateTime? @map("cancel_requested_at") @db.Timestamptz(3)
  cancelReason      String?   @map("cancel_reason")

  definition ProcessDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  events     ProcessEvent[]
  signals    ProcessSignal[]

  @@index([definitionId])
  @@index([status])
  @@index([runnableAt])
  @@map("process_instances")
}

/// Inbox of signals waiting to be delivered by a worker, in `id` order.
/// Rows are deleted once the worker has applied them.
model ProcessSignal {
  id         BigInt   @id @default(autoincrement())
  instanceId String   @map("instance_id") @db.Uuid
  elementId  String   @map("element_id")
  payload    Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  instance ProcessInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  @@index([instanceId, id])
  @@map("process_signals")
}

/// Append-only audit trail of engine activity for an instance.
/// `id` is a sequence: engine events routinely share a millisecond, so
/// `createdAt` alone cannot order them.
model ProcessEvent {
  id         BigInt   @id @default(autoincrement())
  instanceId String   @map("instance_id") @db.Uuid
  type       String
  elementId  String?  @map("element_id")
  payload    Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  instance ProcessInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  // Every read is "this instance's events in id order".
  @@index([instanceId, id])
  @@map("process_events")
}

/// A protobuf descriptor set (`buf build -o …`), as registered. Services point
/// at the set that describes them; a newer registration adds a new set.
model DescriptorSet {
  id        String   @id @default(uuid(7)) @db.Uuid
  /// Serialized google.protobuf.FileDescriptorSet, imports included.
  content   Bytes
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  services Service[]

  @@map("descriptor_sets")
}

/// A Connect/gRPC service struna can call from a service task. Identified by
/// its full proto name, which the package makes globally unique; the process
/// names only the method, and this row says where the service runs.
model Service {
  /// e.g. "acme.slack.v1.ChatService"
  name            String   @id
  descriptorSetId String   @map("descriptor_set_id") @db.Uuid
  
  baseUrl         String   @map("base_url")
  /// "connect", "grpc" or "grpcweb".
  protocol        String   @default("connect")
  /// Shown in editors (element templates) and on the dashboard's diagrams.
  /// Default: the service's name without its package and "Service" suffix.
  title           String?
  /// A data: URI (SVG or PNG). Default: a generated monogram tile.
  icon            String?
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  descriptorSet DescriptorSet @relation(fields: [descriptorSetId], references: [id])

  @@index([descriptorSetId])
  @@map("services")
}
