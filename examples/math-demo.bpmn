<?xml version="1.0" encoding="UTF-8"?>
<!--
  Service tasks calling a Connect service: the demo MathService and
  GreeterService from examples/services (npm run demo:services).

  Each service task names its method as its zeebe:taskDefinition type; its
  zeebe:inputs make the request (FEEL when they start with "="), and the
  response is kept in variables under the task's id — so "Halve the sum"
  reads the result of "Add a + b" as =add.sum.

  Before deploying, register the services:
    npm run demo:services
    npx struna services add --descriptor examples/services/demo.binpb --url http://localhost:9000

  Start variables: { "a": 30, "b": 12, "name": "world", "locale": "uk" }

  The zeebe namespace and modeler:executionPlatform mark the file as
  Camunda 8, so Camunda-based editors (e.g. the BPMN Modeler extension for
  VS Code) open it in that mode — the one struna's element templates and
  service icons are for.
-->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
             xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
             xmlns:modeler="http://camunda.org/schema/modeler/1.0"
             modeler:executionPlatform="Camunda Cloud"
             modeler:executionPlatformVersion="8.7.0"
             id="math-demo-definitions"
             targetNamespace="http://struna.io/bpmn">
  <process id="math_demo" name="Math demo" isExecutable="true">

    <startEvent id="numbers_received" name="Numbers received">
      <outgoing>to_add</outgoing>
    </startEvent>
    <sequenceFlow id="to_add" sourceRef="numbers_received" targetRef="add" />

    <serviceTask id="add" name="Add a + b" zeebe:modelerTemplate="acme.demo.v1.MathService/Add" zeebe:modelerTemplateVersion="1" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
      <documentation>MathService/Add with the start variables a and b. Result: { "sum": … }</documentation>
      <extensionElements>
        <zeebe:taskDefinition type="acme.demo.v1.MathService/Add" />
        <zeebe:ioMapping>
          <zeebe:input source="=a" target="a" />
          <zeebe:input source="=b" target="b" />
        </zeebe:ioMapping>
      </extensionElements>
      <incoming>to_add</incoming>
      <outgoing>to_halve</outgoing>
    </serviceTask>
    <sequenceFlow id="to_halve" sourceRef="add" targetRef="halve" />

    <serviceTask id="halve" name="Halve the sum" zeebe:modelerTemplate="acme.demo.v1.MathService/Divide" zeebe:modelerTemplateVersion="1" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
      <documentation>MathService/Divide of the previous step's sum by 2. Result: { "quotient": … }</documentation>
      <extensionElements>
        <zeebe:taskDefinition type="acme.demo.v1.MathService/Divide" />
        <zeebe:ioMapping>
          <zeebe:input source="=add.sum" target="a" />
          <zeebe:input source="2" target="b" />
        </zeebe:ioMapping>
      </extensionElements>
      <incoming>to_halve</incoming>
      <outgoing>to_big</outgoing>
    </serviceTask>
    <sequenceFlow id="to_big" sourceRef="halve" targetRef="big" />

    <exclusiveGateway id="big" name="Over 10?" default="small">
      <incoming>to_big</incoming>
      <outgoing>large</outgoing>
      <outgoing>small</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="large" name="yes" sourceRef="big" targetRef="greet">
      <conditionExpression xsi:type="tFormalExpression" language="javascript">next(null, environment.variables.halve.quotient &gt; 10)</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="small" name="no" sourceRef="big" targetRef="too_small" />
    <endEvent id="too_small" name="Too small">
      <incoming>small</incoming>
    </endEvent>

    <serviceTask id="greet" name="Greet" zeebe:modelerTemplate="acme.demo.v1.GreeterService/Greet" zeebe:modelerTemplateVersion="1" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
      <documentation>GreeterService/Greet in the start variable locale (de, fr, uk, es; anything else is English). Result: { "message": … }</documentation>
      <extensionElements>
        <zeebe:taskDefinition type="acme.demo.v1.GreeterService/Greet" />
        <zeebe:ioMapping>
          <zeebe:input source="=name" target="name" />
          <zeebe:input source="=locale" target="locale" />
        </zeebe:ioMapping>
      </extensionElements>
      <incoming>large</incoming>
      <outgoing>to_done</outgoing>
    </serviceTask>
    <sequenceFlow id="to_done" sourceRef="greet" targetRef="done" />
    <endEvent id="done" name="Done">
      <incoming>to_done</incoming>
    </endEvent>
  </process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_math_demo">
    <bpmndi:BPMNPlane id="BPMNPlane_math_demo" bpmnElement="math_demo">
      <bpmndi:BPMNShape id="numbers_received_di" bpmnElement="numbers_received">
        <dc:Bounds x="57" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="add_di" bpmnElement="add">
        <dc:Bounds x="175" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="halve_di" bpmnElement="halve">
        <dc:Bounds x="325" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="big_di" bpmnElement="big" isMarkerVisible="true">
        <dc:Bounds x="500" y="45" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="greet_di" bpmnElement="greet">
        <dc:Bounds x="625" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="done_di" bpmnElement="done">
        <dc:Bounds x="807" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="too_small_di" bpmnElement="too_small">
        <dc:Bounds x="657" y="192" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="to_add_di" bpmnElement="to_add">
        <di:waypoint x="93" y="70" />
        <di:waypoint x="175" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="to_halve_di" bpmnElement="to_halve">
        <di:waypoint x="275" y="70" />
        <di:waypoint x="325" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="to_big_di" bpmnElement="to_big">
        <di:waypoint x="425" y="70" />
        <di:waypoint x="500" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="large_di" bpmnElement="large">
        <di:waypoint x="550" y="70" />
        <di:waypoint x="625" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="small_di" bpmnElement="small">
        <di:waypoint x="525" y="95" />
        <di:waypoint x="525" y="210" />
        <di:waypoint x="657" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="to_done_di" bpmnElement="to_done">
        <di:waypoint x="725" y="70" />
        <di:waypoint x="807" y="70" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</definitions>
