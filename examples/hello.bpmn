<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
             id="hello-definitions"
             targetNamespace="http://struna.io/bpmn">
  <process id="hello" isExecutable="true">
    <startEvent id="start" />
    <sequenceFlow id="to-review" sourceRef="start" targetRef="review" />
    <!-- A user task waits for SignalInstance(elementId="review"). -->
    <userTask id="review" name="Review request" />
    <sequenceFlow id="to-end" sourceRef="review" targetRef="end" />
    <endEvent id="end" />
  </process>
</definitions>
