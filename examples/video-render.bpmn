<?xml version="1.0" encoding="UTF-8"?>
<!--
  Agentic video render: AI agents do the work, people approve it.

  Agent steps are receive tasks: struna parks the instance until the agent
  reports back with SignalInstance(elementId=<task id>, payload=<result>).
  Human steps are user tasks, completed the same way from the dashboard or
  the API. Each task's result is kept in variables under its id, so the
  gateways read e.g. environment.variables.review_script.approved.

  Start variables: { "brief": "...", "budget_usd": 100 }

  The zeebe namespace and modeler:executionPlatform mark the file as
  Camunda 8, so Camunda-based editors (e.g. the BPMN Modeler extension for
  VS Code) open it in that mode — the one struna's element templates and
  service icons are for.
-->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
             xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
             xmlns:modeler="http://camunda.org/schema/modeler/1.0"
             modeler:executionPlatform="Camunda Cloud"
             modeler:executionPlatformVersion="8.7.0"
             id="video-render-definitions"
             targetNamespace="http://struna.io/bpmn">
  <process id="video_render" name="Agentic video render" isExecutable="true">

    <startEvent id="brief_received" name="Brief received">
      <outgoing>to_draft</outgoing>
    </startEvent>
    <sequenceFlow id="to_draft" sourceRef="brief_received" targetRef="draft_merge" />
    <exclusiveGateway id="draft_merge">
      <incoming>to_draft</incoming>
      <incoming>revise_script</incoming>
      <outgoing>to_draft_script</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="to_draft_script" sourceRef="draft_merge" targetRef="draft_script" />

    <receiveTask id="draft_script" name="Draft script (agent)">
      <documentation>Script agent writes the script from the brief (and the reviewer's feedback on a revision). Signal: { "script": "...", "scenes": 5 }</documentation>
      <incoming>to_draft_script</incoming>
      <outgoing>to_review_script</outgoing>
    </receiveTask>
    <sequenceFlow id="to_review_script" sourceRef="draft_script" targetRef="review_script" />

    <userTask id="review_script" name="Review script">
      <documentation>Editor approves the script or sends it back. Signal: { "approved": true } or { "approved": false, "feedback": "..." }</documentation>
      <extensionElements>
        <zeebe:userTask />
      </extensionElements>
      <incoming>to_review_script</incoming>
      <outgoing>to_script_ok</outgoing>
    </userTask>
    <sequenceFlow id="to_script_ok" sourceRef="review_script" targetRef="script_ok" />

    <exclusiveGateway id="script_ok" name="Script approved?" default="revise_script">
      <incoming>to_script_ok</incoming>
      <outgoing>script_approved</outgoing>
      <outgoing>revise_script</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="script_approved" name="approved" sourceRef="script_ok" targetRef="estimate_cost">
      <conditionExpression xsi:type="tFormalExpression" language="javascript">next(null, environment.variables.review_script.approved === true)</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="revise_script" name="revise" sourceRef="script_ok" targetRef="draft_merge" />

    <scriptTask id="estimate_cost" name="Estimate render cost" scriptFormat="javascript">
      <documentation>$12 per scene, from the approved draft.</documentation>
      <incoming>script_approved</incoming>
      <outgoing>to_budget_check</outgoing>
      <script>var draft = environment.variables.draft_script || {};
next(null, { usd: (draft.scenes || 1) * 12 });</script>
    </scriptTask>
    <sequenceFlow id="to_budget_check" sourceRef="estimate_cost" targetRef="budget_check" />

    <exclusiveGateway id="budget_check" name="Within budget?" default="over_budget">
      <incoming>to_budget_check</incoming>
      <outgoing>within_budget</outgoing>
      <outgoing>over_budget</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="within_budget" name="yes" sourceRef="budget_check" targetRef="assets_merge">
      <conditionExpression xsi:type="tFormalExpression" language="javascript">next(null, environment.variables.estimate_cost.usd &lt;= (environment.variables.budget_usd || 100))</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="over_budget" name="no" sourceRef="budget_check" targetRef="approve_budget" />

    <userTask id="approve_budget" name="Approve budget (producer)">
      <documentation>The estimate is over budget_usd. Signal: { "approved": true } to spend it anyway.</documentation>
      <extensionElements>
        <zeebe:userTask />
      </extensionElements>
      <incoming>over_budget</incoming>
      <outgoing>to_budget_ok</outgoing>
    </userTask>
    <sequenceFlow id="to_budget_ok" sourceRef="approve_budget" targetRef="budget_ok" />

    <exclusiveGateway id="budget_ok" name="Budget approved?" default="budget_refused">
      <incoming>to_budget_ok</incoming>
      <outgoing>budget_approved</outgoing>
      <outgoing>budget_refused</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="budget_approved" name="yes" sourceRef="budget_ok" targetRef="assets_merge">
      <conditionExpression xsi:type="tFormalExpression" language="javascript">next(null, environment.variables.approve_budget.approved === true)</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="budget_refused" name="no" sourceRef="budget_ok" targetRef="stopped_over_budget" />
    <endEvent id="stopped_over_budget" name="Stopped: over budget">
      <incoming>budget_refused</incoming>
    </endEvent>

    <exclusiveGateway id="assets_merge">
      <incoming>within_budget</incoming>
      <incoming>budget_approved</incoming>
      <outgoing>to_assets</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="to_assets" sourceRef="assets_merge" targetRef="make_assets" />

    <parallelGateway id="make_assets" name="Make assets">
      <incoming>to_assets</incoming>
      <outgoing>to_storyboard</outgoing>
      <outgoing>to_voiceover</outgoing>
    </parallelGateway>
    <sequenceFlow id="to_storyboard" sourceRef="make_assets" targetRef="generate_storyboard" />
    <sequenceFlow id="to_voiceover" sourceRef="make_assets" targetRef="generate_voiceover" />

    <receiveTask id="generate_storyboard" name="Generate storyboard (agent)">
      <documentation>Image agent draws a frame per scene. Signal: { "frames": ["https://…"] }</documentation>
      <incoming>to_storyboard</incoming>
      <outgoing>storyboard_done</outgoing>
    </receiveTask>
    <receiveTask id="generate_voiceover" name="Generate voiceover (agent)">
      <documentation>Voice agent reads the script. Signal: { "audio": "https://…" }</documentation>
      <incoming>to_voiceover</incoming>
      <outgoing>voiceover_done</outgoing>
    </receiveTask>
    <sequenceFlow id="storyboard_done" sourceRef="generate_storyboard" targetRef="assets_ready" />
    <sequenceFlow id="voiceover_done" sourceRef="generate_voiceover" targetRef="assets_ready" />

    <parallelGateway id="assets_ready" name="Assets ready">
      <incoming>storyboard_done</incoming>
      <incoming>voiceover_done</incoming>
      <outgoing>to_render_merge</outgoing>
    </parallelGateway>
    <sequenceFlow id="to_render_merge" sourceRef="assets_ready" targetRef="render_merge" />
    <exclusiveGateway id="render_merge">
      <incoming>to_render_merge</incoming>
      <incoming>render_again</incoming>
      <outgoing>to_render</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="to_render" sourceRef="render_merge" targetRef="render_video" />

    <receiveTask id="render_video" name="Render video (agent)">
      <documentation>Render agent assembles frames and audio. Signal: { "url": "https://…/video.mp4" }. If it takes over 2 hours, a person looks into it.</documentation>
      <incoming>to_render</incoming>
      <outgoing>to_final_review</outgoing>
    </receiveTask>
    <boundaryEvent id="render_timeout" name="2 hours" attachedToRef="render_video">
      <outgoing>to_investigate</outgoing>
      <timerEventDefinition>
        <timeDuration xsi:type="tFormalExpression">PT2H</timeDuration>
      </timerEventDefinition>
    </boundaryEvent>
    <sequenceFlow id="to_investigate" sourceRef="render_timeout" targetRef="investigate_render" />
    <userTask id="investigate_render" name="Investigate stalled render">
      <documentation>The render agent went quiet. Fix it, then signal { } to render again.</documentation>
      <extensionElements>
        <zeebe:userTask />
      </extensionElements>
      <incoming>to_investigate</incoming>
      <outgoing>render_again</outgoing>
    </userTask>
    <sequenceFlow id="render_again" sourceRef="investigate_render" targetRef="render_merge" />

    <sequenceFlow id="to_final_review" sourceRef="render_video" targetRef="final_review" />
    <userTask id="final_review" name="Final review">
      <documentation>Watch the cut. Signal: { "approved": true } to publish, { "approved": false } to reject.</documentation>
      <extensionElements>
        <zeebe:userTask />
      </extensionElements>
      <incoming>to_final_review</incoming>
      <outgoing>to_release_ok</outgoing>
    </userTask>
    <sequenceFlow id="to_release_ok" sourceRef="final_review" targetRef="release_ok" />

    <exclusiveGateway id="release_ok" name="Approved for release?" default="release_rejected">
      <incoming>to_release_ok</incoming>
      <outgoing>release_approved</outgoing>
      <outgoing>release_rejected</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="release_approved" name="yes" sourceRef="release_ok" targetRef="publish">
      <conditionExpression xsi:type="tFormalExpression" language="javascript">next(null, environment.variables.final_review.approved === true)</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="release_rejected" name="no" sourceRef="release_ok" targetRef="rejected" />

    <scriptTask id="publish" name="Publish" scriptFormat="javascript">
      <incoming>release_approved</incoming>
      <outgoing>to_published</outgoing>
      <script>next(null, { url: environment.variables.render_video.url, publishedAt: new Date().toISOString() });</script>
    </scriptTask>
    <sequenceFlow id="to_published" sourceRef="publish" targetRef="published" />
    <endEvent id="published" name="Published">
      <incoming>to_published</incoming>
    </endEvent>
    <endEvent id="rejected" name="Rejected">
      <incoming>release_rejected</incoming>
    </endEvent>
  </process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_video_render">
    <bpmndi:BPMNPlane id="BPMNPlane_video_render" bpmnElement="video_render">
      <bpmndi:BPMNShape id="brief_received_di" bpmnElement="brief_received">
        <dc:Bounds x="57" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="draft_merge_di" bpmnElement="draft_merge" isMarkerVisible="true">
        <dc:Bounds x="200" y="45" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="draft_script_di" bpmnElement="draft_script">
        <dc:Bounds x="325" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="review_script_di" bpmnElement="review_script">
        <dc:Bounds x="475" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="script_ok_di" bpmnElement="script_ok" isMarkerVisible="true">
        <dc:Bounds x="650" y="45" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="estimate_cost_di" bpmnElement="estimate_cost">
        <dc:Bounds x="775" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="budget_check_di" bpmnElement="budget_check" isMarkerVisible="true">
        <dc:Bounds x="950" y="45" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="assets_merge_di" bpmnElement="assets_merge" isMarkerVisible="true">
        <dc:Bounds x="1400" y="45" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="make_assets_di" bpmnElement="make_assets">
        <dc:Bounds x="1550" y="45" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="generate_storyboard_di" bpmnElement="generate_storyboard">
        <dc:Bounds x="1675" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="assets_ready_di" bpmnElement="assets_ready">
        <dc:Bounds x="1850" y="45" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="render_merge_di" bpmnElement="render_merge" isMarkerVisible="true">
        <dc:Bounds x="2000" y="45" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="render_video_di" bpmnElement="render_video">
        <dc:Bounds x="2125" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="render_timeout_di" bpmnElement="render_timeout">
        <dc:Bounds x="2157" y="92" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="final_review_di" bpmnElement="final_review">
        <dc:Bounds x="2275" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="release_ok_di" bpmnElement="release_ok" isMarkerVisible="true">
        <dc:Bounds x="2450" y="45" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="publish_di" bpmnElement="publish">
        <dc:Bounds x="2575" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="published_di" bpmnElement="published">
        <dc:Bounds x="2757" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="approve_budget_di" bpmnElement="approve_budget">
        <dc:Bounds x="1075" y="170" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="budget_ok_di" bpmnElement="budget_ok" isMarkerVisible="true">
        <dc:Bounds x="1250" y="185" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="stopped_over_budget_di" bpmnElement="stopped_over_budget">
        <dc:Bounds x="1407" y="192" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="generate_voiceover_di" bpmnElement="generate_voiceover">
        <dc:Bounds x="1675" y="170" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="investigate_render_di" bpmnElement="investigate_render">
        <dc:Bounds x="2275" y="170" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="rejected_di" bpmnElement="rejected">
        <dc:Bounds x="2607" y="192" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="to_draft_di" bpmnElement="to_draft">
        <di:waypoint x="93" y="70" />
        <di:waypoint x="200" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="to_draft_script_di" bpmnElement="to_draft_script">
        <di:waypoint x="250" y="70" />
        <di:waypoint x="325" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="to_review_script_di" bpmnElement="to_review_script">
        <di:waypoint x="425" y="70" />
        <di:waypoint x="475" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="to_script_ok_di" bpmnElement="to_script_ok">
        <di:waypoint x="575" y="70" />
        <di:waypoint x="650" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="script_approved_di" bpmnElement="script_approved">
        <di:waypoint x="700" y="70" />
        <di:waypoint x="775" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="revise_script_di" bpmnElement="revise_script">
        <di:waypoint x="675" y="95" />
        <di:waypoint x="675" y="140" />
        <di:waypoint x="225" y="140" />
        <di:waypoint x="225" y="95" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="to_budget_check_di" bpmnElement="to_budget_check">
        <di:waypoint x="875" y="70" />
        <di:waypoint x="950" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="within_budget_di" bpmnElement="within_budget">
        <di:waypoint x="1000" y="70" />
        <di:waypoint x="1400" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="over_budget_di" bpmnElement="over_budget">
        <di:waypoint x="975" y="95" />
        <di:waypoint x="975" y="210" />
        <di:waypoint x="1075" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="to_assets_di" bpmnElement="to_assets">
        <di:waypoint x="1450" y="70" />
        <di:waypoint x="1550" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="to_storyboard_di" bpmnElement="to_storyboard">
        <di:waypoint x="1600" y="70" />
        <di:waypoint x="1675" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="to_voiceover_di" bpmnElement="to_voiceover">
        <di:waypoint x="1575" y="95" />
        <di:waypoint x="1575" y="210" />
        <di:waypoint x="1675" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="storyboard_done_di" bpmnElement="storyboard_done">
        <di:waypoint x="1775" y="70" />
        <di:waypoint x="1850" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="to_render_merge_di" bpmnElement="to_render_merge">
        <di:waypoint x="1900" y="70" />
        <di:waypoint x="2000" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="to_render_di" bpmnElement="to_render">
        <di:waypoint x="2050" y="70" />
        <di:waypoint x="2125" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="to_final_review_di" bpmnElement="to_final_review">
        <di:waypoint x="2225" y="70" />
        <di:waypoint x="2275" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="to_investigate_di" bpmnElement="to_investigate">
        <di:waypoint x="2175" y="128" />
        <di:waypoint x="2175" y="210" />
        <di:waypoint x="2275" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="to_release_ok_di" bpmnElement="to_release_ok">
        <di:waypoint x="2375" y="70" />
        <di:waypoint x="2450" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="release_approved_di" bpmnElement="release_approved">
        <di:waypoint x="2500" y="70" />
        <di:waypoint x="2575" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="release_rejected_di" bpmnElement="release_rejected">
        <di:waypoint x="2475" y="95" />
        <di:waypoint x="2475" y="210" />
        <di:waypoint x="2607" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="to_published_di" bpmnElement="to_published">
        <di:waypoint x="2675" y="70" />
        <di:waypoint x="2757" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="to_budget_ok_di" bpmnElement="to_budget_ok">
        <di:waypoint x="1175" y="210" />
        <di:waypoint x="1250" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="budget_approved_di" bpmnElement="budget_approved">
        <di:waypoint x="1300" y="210" />
        <di:waypoint x="1350" y="210" />
        <di:waypoint x="1350" y="140" />
        <di:waypoint x="1350" y="140" />
        <di:waypoint x="1350" y="70" />
        <di:waypoint x="1400" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="budget_refused_di" bpmnElement="budget_refused">
        <di:waypoint x="1300" y="210" />
        <di:waypoint x="1407" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="voiceover_done_di" bpmnElement="voiceover_done">
        <di:waypoint x="1775" y="210" />
        <di:waypoint x="1875" y="210" />
        <di:waypoint x="1875" y="95" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="render_again_di" bpmnElement="render_again">
        <di:waypoint x="2325" y="250" />
        <di:waypoint x="2325" y="280" />
        <di:waypoint x="2025" y="280" />
        <di:waypoint x="2025" y="95" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</definitions>
